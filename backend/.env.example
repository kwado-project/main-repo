# ---- Core ----
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.kwado.ai
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://kwado:kwado@localhost:5432/kwado
# DATABASE_REPLICA_URL=postgres://kwado:kwado@replica:5432/kwado
REDIS_URL=redis://localhost:6379/0

# ---- Email: AWS SES (set EMAIL_PROVIDER=ses in production) ----
EMAIL_PROVIDER=console
AWS_SES_REGION=eu-west-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=
# Must be on a domain verified in SES, e.g. Kwado AI <no-reply@yourdomain.com>
DEFAULT_FROM_EMAIL=
# Optional alternative: any SMTP server (EMAIL_PROVIDER=smtp), e.g. Gmail with an App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---- Storage: Cloudflare R2 (set STORAGE_PROVIDER=r2 in production) ----
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kwado-materials

# ---- Payments: Paystack ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- AI ----
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-opus-5-5
VOYAGE_API_KEY=
