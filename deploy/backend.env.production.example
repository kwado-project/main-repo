# Copy to backend/.env on the VPS and fill in every value.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,localhost
FRONTEND_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
SECURE_SSL_REDIRECT=1

# Resend — the sender must be on a domain verified in Resend.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Kwado AI <no-reply@yourdomain.com>

STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kwado-materials

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# AI — set one or both keys. Anthropic is used when its key is set, otherwise OpenAI.
# AI_PROVIDER=anthropic|openai forces a provider (its key must be set).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=
AI_ANTHROPIC_MODEL=claude-opus-5-5
AI_OPENAI_MODEL=gpt-5.5
# Embeddings for searching student notes: Voyage if set, else OpenAI if its key is set
VOYAGE_API_KEY=

# Past-question research pipeline (all optional; see docs/RESEARCH.md)
RESEARCH_AUTORUN=0
RESEARCH_AI_REVIEW=0
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
