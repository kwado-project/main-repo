# Copy to backend/.env on the VPS and fill in every value.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,localhost
FRONTEND_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
SECURE_SSL_REDIRECT=1

# Gmail SMTP — EMAIL_HOST_PASSWORD is a Google App Password, not your Gmail password.
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=youraccount@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Kwado AI <youraccount@gmail.com>

STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kwado-materials

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-opus-5-5
VOYAGE_API_KEY=
